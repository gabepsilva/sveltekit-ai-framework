{
	"name": "sveltekit-ai-framework",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"overrides": {
		"qs": "6.15.2"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync && git config core.hooksPath .githooks 2>/dev/null || true",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:scripts": "tsc --project ./scripts/tsconfig.json --noEmit",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:suppressions": "bun scripts/quality/suppressions.ts",
		"check:thresholds": "bun scripts/quality/thresholds.ts",
		"check:workflows": "bun scripts/quality/actionlint.ts",
		"check:bundle": "bun scripts/quality/bundle-budget.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "bun scripts/quality/eslint.ts",
		"lint:docs": "markdownlint-cli2",
		"spellcheck": "cspell --no-progress .",
		"knip": "knip",
		"duplicates:scan": "jscpd --no-tips --no-colors src scripts",
		"duplicates": "bun run duplicates:scan && bun scripts/quality/duplication.ts",
		"test:unit": "vitest run --reporter=default --reporter=json --outputFile.json=reports/quality/vitest.json",
		"test:unit:server": "vitest run --project server --reporter=default --reporter=json --outputFile.json=reports/quality/vitest-server.json",
		"test:unit:watch": "vitest",
		"test:coverage": "bun run test:coverage:client && bun run test:coverage:server",
		"test:coverage:client": "vitest run --coverage --project client --coverage.include='src/lib/**/*.{ts,svelte}' --coverage.exclude='src/lib/server/**' --coverage.exclude='src/**/*.{test,spec}.{js,ts}' --coverage.reportsDirectory=coverage/client --reporter=default --reporter=json --outputFile.json=reports/quality/vitest-client.json",
		"test:coverage:server": "vitest run --coverage --project server --coverage.include='src/lib/server/**/*.ts' --coverage.exclude='src/**/*.{test,spec}.{js,ts}' --coverage.reportsDirectory=coverage/server --reporter=default --reporter=json --outputFile.json=reports/quality/vitest-server.json",
		"test:mutation": "stryker run",
		"test:gates": "bun scripts/quality/self-test.ts",
		"test:e2e": "playwright test",
		"test:e2e:all": "E2E_ALL_BROWSERS=1 playwright test",
		"test:e2e:security": "bun scripts/security/zap.ts",
		"test": "bun run test:unit && bun run test:e2e",
		"security:images": "bun scripts/security/images.ts",
		"security:gitleaks": "bun scripts/security/gitleaks.ts",
		"security:semgrep": "bun scripts/security/semgrep.ts",
		"security:trivy": "bun scripts/security/trivy.ts",
		"security:blocking": "bun run security:gitleaks && bun run security:semgrep",
		"security:advisory": "bun run security:trivy && bun run test:e2e:security",
		"security": "bun run security:blocking && bun run security:advisory",
		"precommit": "bun scripts/quality/gate.ts verify:fast --bail --only format:check,lint,check:suppressions",
		"verify:fast": "bun scripts/quality/gate.ts verify:fast",
		"verify": "bun scripts/quality/gate.ts verify",
		"verify:deep": "bun scripts/quality/gate.ts verify:deep",
		"ci": "bun scripts/quality/gate.ts ci",
		"nightly": "bun scripts/quality/gate.ts nightly"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@stryker-mutator/api": "9.6.1",
		"@stryker-mutator/core": "9.6.1",
		"@stryker-mutator/vitest-runner": "9.6.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"@vitest/coverage-istanbul": "^4.1.10",
		"@vitest/eslint-plugin": "^1.6.23",
		"cspell": "10.0.1",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-playwright": "^2.10.5",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"jscpd": "5.0.12",
		"knip": "^6.27.0",
		"markdownlint-cli2": "0.23.1",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	}
}
